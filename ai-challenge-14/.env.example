# PostgreSQL started by `docker compose up -d postgres`
DATABASE_URL=postgres://claims:claims@localhost:5432/claims
# How long a write waits for another request's lock on the same claim before CLAIM_BUSY (409)
DB_LOCK_TIMEOUT_MS=5000
DB_POOL_MAX=10

# Enables GET /dev/clock and POST /dev/clock/advance (fake clock for appeal deadlines)
DEMO_MODE=true

# API port
PORT=3000
